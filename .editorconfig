root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,json5,neon}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Reflow fixtures encode expected output byte-for-byte, and a CommonMark hard break *is* two
# trailing spaces — trimming them would silently rewrite what the fixture asserts.
[*.fixture]
trim_trailing_whitespace = false
